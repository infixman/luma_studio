# Storefront build (`vite build`, mode=production).
#
# These are public URLs, not secrets — they end up inline in the shipped
# bundle either way. They live here rather than in the CI job because the two
# builds need different values, and one shell variable feeding both is how the
# back office would quietly end up talking to the public API.
VITE_API_BASE=https://api.luma-studio.tw
VITE_PUBLIC_API_BASE=https://api.luma-studio.tw
VITE_STOREFRONT_ORIGIN=https://luma-studio.tw
