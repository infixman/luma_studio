{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luma-studio-web",
  "compatibility_date": "2026-07-21",
  // Static-only deployment: the JSON API lives in the separate `luma-studio` Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
