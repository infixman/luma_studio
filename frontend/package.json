{
  "name": "luma-studio-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:admin": "vite --mode admin",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "build": "npm run typecheck && npm run build:storefront && npm run build:admin",
    "build:storefront": "vite build",
    "build:admin": "vite build --mode admin",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "deploy:admin": "wrangler deploy -c wrangler.admin.jsonc"
  },
  "dependencies": {
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "26.1.1",
    "happy-dom": "^20.11.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
