# Back office build (`vite build --mode admin`).
#
# Vite loads .env.<mode>, so this file is read for the admin build and never
# for the storefront one.
#
# Authenticated calls go to the admin Worker; images, avatars and click
# redirects still come from the public API, and links the owner copies out of
# the back office have to point at the customer-facing site rather than at
# admin.luma-studio.tw.
VITE_API_BASE=https://admin-api.luma-studio.tw
VITE_PUBLIC_API_BASE=https://api.luma-studio.tw
VITE_STOREFRONT_ORIGIN=https://luma-studio.tw
